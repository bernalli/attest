{
  "name": "attest-verifier",
  "version": "0.9.1",
  "description": "Offline verifier for attest: durable, portable proof the buyer holds; the seller signs a receipt, the buyer keeps the file, anyone verifies offline after the store is gone.",
  "license": "Apache-2.0",
  "author": "Samuele Martinalli",
  "homepage": "https://attest-receipts.org/",
  "repository": { "type": "git", "url": "git+https://github.com/bernalli/attest.git", "directory": "verifiers/ts" },
  "funding": "https://github.com/sponsors/bernalli",
  "bugs": { "url": "https://github.com/bernalli/attest/issues" },
  "keywords": ["digital-ownership", "receipts", "verifier", "offline-verification", "ed25519", "drm-free", "digital-goods"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "~0.6.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.14.0"
  }
}
